[sub_resource type="GDScript" id="GDScript_b4p0n"]
script/source = "extends PanelContainer

func _ready() -> void:
	var tween : Tween = create_tween().set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.set_loops()
"

